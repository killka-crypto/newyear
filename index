<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>Новый год: Начало чуда — зимний симулятор</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#101923;color:#fff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}canvas{display:block}
#hud{position:fixed;inset:0;pointer-events:none}.glass{background:linear-gradient(135deg,#101b29d9,#101b29a8);border:1px solid #ffffff25;box-shadow:0 12px 40px #0004;backdrop-filter:blur(10px);border-radius:14px}
#top{position:absolute;top:12px;left:12px;padding:12px 15px;width:min(370px,75vw)}#title{font-weight:800;color:#f4d184}#sub{font-size:13px;color:#d5e2ef;margin-top:4px}#stats{font-size:12px;color:#b7d1e9;margin-top:8px}
#inventory{position:absolute;top:12px;right:12px;padding:10px 13px;max-width:190px;font-size:12px}#inventory strong{color:#f4d184}
#hint{position:absolute;bottom:23%;left:50%;transform:translateX(-50%);padding:12px 17px;display:none;text-align:center;max-width:90%}
#toast{position:absolute;top:25%;left:50%;transform:translateX(-50%);padding:12px 18px;display:none;text-align:center;max-width:90%}
#menu{pointer-events:auto;position:absolute;inset:0;display:flex;align-items:center;padding:clamp(20px,7vw,90px);background:linear-gradient(90deg,#09121de8,#09121d85 52%,transparent),linear-gradient(0deg,#09121d50,transparent);overflow:auto}
#panel{max-width:560px}h1{font-size:clamp(38px,8vw,78px);line-height:.98;margin:0 0 15px;text-shadow:0 4px 32px #7ab5ff50}#panel p{line-height:1.55;color:#d7e4f2}
button{pointer-events:auto;border:0;border-radius:11px;padding:13px 18px;background:#e6bd67;color:#1a2027;font-weight:800;font-size:15px;margin:6px 5px 6px 0;cursor:pointer}button.secondary{background:#183148;color:white;border:1px solid #53728e}#mobile{pointer-events:auto;position:absolute;bottom:16px;left:16px;display:none}#mobile button{background:#102b42d9;color:#fff;border:1px solid #ffffff50;width:54px;height:54px;padding:0;font-size:19px;touch-action:none}#look{pointer-events:auto;position:absolute;bottom:20px;right:15px;width:145px;height:145px;border-radius:50%;background:#ffffff0c;border:1px solid #ffffff35;display:none;touch-action:none}#interact{pointer-events:auto;position:absolute;bottom:20px;right:18px;display:none}#mapnote{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);font-size:11px;color:#e2e8ef;text-shadow:0 2px 4px #000;text-align:center;width:90%}
@media(max-width:700px){#top{width:70vw;padding:9px 11px}#inventory{max-width:26vw;padding:8px;font-size:11px}#mapnote{bottom:4px}}
</style></head><body>
<div id="hud"><div id="top" class="glass"><div id="title">Загрузка...</div><div id="sub"></div><div id="stats"></div></div><div id="inventory" class="glass"><strong>Сумка</strong><div id="items">Пока пусто</div></div><div id="hint" class="glass"></div><div id="toast" class="glass"></div>
<div id="mobile"><div style="display:grid;grid-template-columns:repeat(3,54px);gap:4px"><span></span><button data-m="f">▲</button><span></span><button data-m="l">◀</button><button data-m="b">▼</button><button data-m="r">▶</button></div></div><div id="look"></div><div id="interact"><button id="ebtn">Взаимодействовать</button></div><div id="mapnote">WASD · мышь · E — действие · Shift — бег · F — сохранение · Esc — меню</div>
<div id="menu"><div id="panel"><h1>Новый год:<br><span style="color:#e7c77c">Начало чуда</span></h1><p>Последние дни декабря. Улицы покрыты снегом, витрины светятся, а в квартире ждёт список дел. Собери всё для праздника, гуляй по городу, заглядывай в магазины и создавай своё настроение.</p><button id="start">Начать новую игру</button><button class="secondary" id="load">Продолжить</button><button class="secondary" id="how">Управление</button><p style="font-size:12px">Автосохранение включено. Сохраняются позиция, покупки и задания.</p></div></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r152/three.min.js"></script><script>
(()=>{const $=id=>document.getElementById(id);let scene,camera,renderer,clock,snow;let started=false,paused=true,keys={},interactables=[],near=null,yaw=0,pitch=0,elapsed=0,money=3500,items=[],quest=0,saveTick=0;
const tasks=[["Домашнее утро","Осмотри квартиру и возьми список дел."],["Продукты","Зайди в супермаркет и купи продукты к праздничному столу."],["Центральная площадь","Прогуляйся до главной ёлки и осмотри праздничный город."],["Ёлочный базар","Найди продавца ёлок и купи деревце."],["Дом","Вернись домой и поставь ёлку."],["Подарки","Выбери подарок в торговом центре."],["Почта","Отправь открытку близким."],["Кафе","Зайди погреться и возьми горячий напиток."],["Сосед","Поздравь соседа у подъезда."],["Вечерний маршрут","Пройдись по освещённым улицам."],["Украшения","Купи гирлянду и укрась квартиру."],["Тихий вечер","Вернись домой. Праздничные приготовления завершены!"]];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function init(){scene=new THREE.Scene();scene.background=new THREE.Color(0x8299ad);scene.fog=new THREE.FogExp2(0x8299ad,.0048);camera=new THREE.PerspectiveCamera(76,innerWidth/innerHeight,.1,350);camera.position.set(-42,1.72,-42);renderer=new THREE.WebGLRenderer({antialias:true});renderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.12;document.body.appendChild(renderer.domElement);clock=new THREE.Clock();scene.add(new THREE.HemisphereLight(0xcfe4ff,0x4b5360,1.9));let sun=new THREE.DirectionalLight(0xffdfb5,2.5);sun.position.set(-45,70,25);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-100;sun.shadow.camera.right=100;sun.shadow.camera.top=100;sun.shadow.camera.bottom=-100;scene.add(sun);let moon=new THREE.DirectionalLight(0x9fc6ff,.7);moon.position.set(50,35,-40);scene.add(moon);city();snowflakes();events();resize();animate();}
function texture(kind){let c=document.createElement('canvas');c.width=c.height=512;let ctx=c.getContext('2d');let base={brick:'#776c63',plaster:'#8a9299',road:'#323943',snow:'#e7edf2',wood:'#73533d',pavement:'#6d7781',roof:'#4c5660'}[kind]||'#777';ctx.fillStyle=base;ctx.fillRect(0,0,512,512);
if(kind==='brick'){for(let y=0;y<512;y+=32){let off=(y/32%2)*36;for(let x=-50;x<560;x+=72){ctx.fillStyle=['#82776d','#665c54','#95877a','#70665e'][Math.floor(Math.random()*4)];ctx.fillRect(x+off,y,68,29);ctx.strokeStyle='#b3a99f';ctx.strokeRect(x+off,y,68,29)}}}
if(kind==='road'||kind==='pavement'){for(let i=0;i<3500;i++){let x=Math.random()*512,y=Math.random()*512;ctx.fillStyle=Math.random()>.5?'#ffffff14':'#00000012';ctx.fillRect(x,y,Math.random()*3+1,Math.random()*3+1);}if(kind==='pavement'){ctx.strokeStyle='#414c57';ctx.lineWidth=3;for(let x=0;x<512;x+=96)ctx.strokeRect(x,0,96,512);for(let y=0;y<512;y+=96)ctx.strokeRect(0,y,512,96)}}
if(kind==='snow'){for(let i=0;i<3000;i++){ctx.fillStyle=Math.random()>.5?'#ffffff':'#c7d4df';ctx.globalAlpha=Math.random()*.6;ctx.fillRect(Math.random()*512,Math.random()*512,Math.random()*4+1,Math.random()*4+1}ctx.globalAlpha=1}
if(kind==='wood'){for(let x=0;x<512;x+=38){ctx.fillStyle=['#65452f','#8a684d','#725139'][Math.floor(Math.random()*3)];ctx.fillRect(x,0,35,512);ctx.strokeStyle='#3b2a20';ctx.strokeRect(x,0,35,512)}}
let t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.wrapS=t.wrapT=THREE.RepeatWrapping;t.anisotropy=4;return t;}
function material(k,rough=1){return new THREE.MeshStandardMaterial({map:texture(k),roughness:rough})}const snowmat=material('snow'),roadmat=material('road'),pavemat=material('pavement'),brickmat=material('brick'),woodmat=material('wood'),glass=new THREE.MeshPhysicalMaterial({color:0x9dbacb,roughness:.18,metalness:.15,transmission:.12}),darkmat=new THREE.MeshStandardMaterial({color:0x252c35,roughness:.95}),green=new THREE.MeshStandardMaterial({color:0x173e2d,roughness:.95}),gold=new THREE.MeshStandardMaterial({color:0xe6b95e,roughness:.35}),red=new THREE.MeshStandardMaterial({color:0x822f39});
function box(x,y,z,sx,sy,sz,m){let o=new THREE.Mesh(new THREE.BoxGeometry(sx,sy,sz),m);o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;scene.add(o);return o;}
function bulb(x,y,z,col=0xffd98a){let o=new THREE.Mesh(new THREE.SphereGeometry(.09,10,8),new THREE.MeshBasicMaterial({color:col}));o.position.set(x,y,z);scene.add(o);let l=new THREE.PointLight(col,.4,3);l.position.set(x,y,z);scene.add(l)}
function building(x,z,w,d,h,mat,shop=false){box(x,h/2,z,w,h,d,mat);let front=z-d/2-.04;for(let y=2.4;y<h-1;y+=3.2)for(let xx=x-w/2+1.6;xx<x+w/2-1;xx+=3.3){box(xx,y,front,1.25,1.65,.09,glass);box(xx,y-.95,front-.06,1.35,.1,.14,darkmat);}box(x,h+.3,z, w*.85,.35,d*.9,darkmat);if(shop){box(x,1.3,front-.4,w*.75,.9,.38,red);box(x,3.15,front-.3,w*.8,.5,.2,gold);for(let i=0;i<9;i++)bulb(x-w*.35+i*w*.087,3.5,front-.5,[0xffd58a,0xfff4ce,0xa8ddff][i%3]);for(let xx=x-w*.4;xx<x+w*.4;xx+=2.5)box(xx,1.7,front-.5,1.4,2.6,.12,glass);}}
function tree(x,z,h=5,decorate=true){box(x,.8,z,.35,1.6,.35,woodmat);for(let i=0;i<4;i++){let cone=new THREE.Mesh(new THREE.ConeGeometry(h*.38*(1-i*.17),h*.38,14),green);cone.position.set(x,h*.28+i*h*.18,z);cone.castShadow=true;scene.add(cone);}if(decorate)for(let i=0;i<35;i++){let a=Math.random()*6.28,y=1+Math.random()*h*.7,r=(h-y)*.27;let b=new THREE.Mesh(new THREE.SphereGeometry(.09,9,9),new THREE.MeshStandardMaterial({color:[0xd6424d,0xf0c65a,0x5cc7e0,0xe5e8e9][i%4],metalness:.25,roughness:.3}));b.position.set(x+Math.cos(a)*r,y,z+Math.sin(a)*r);scene.add(b);}}
function lamp(x,z){box(x,3.7,z,.16,7.4,.16,darkmat);box(x,7.4,z,.9,.14,.14,gold);bulb(x+.38,7.3,z,0xffc77d);let l=new THREE.PointLight(0xffbd74,1.3,13);l.position.set(x+.35,7,z);scene.add(l)}
function city(){let ground=box(0,-.3,0,240,.6,240,snowmat);box(0,-.05,0,16,.2,240,roadmat);box(0,-.04,0,240,.2,16,roadmat);for(let x=-100;x<=100;x+=16){box(x,.02,0,3,.15,240,pavemat);box(0,.02,x,240,.15,3,pavemat);}for(let x=-84;x<=84;x+=24)for(let z=-84;z<=84;z+=24){if(Math.abs(x)<26&&Math.abs(z)<26)continue;building(x,z,17,17,12+Math.random()*20,brickmat);}
building(18,4,18,14,9,brickmat,true);building(-18,-5,18,14,12,brickmat,true);building(4,22,14,18,11,brickmat,true);building(26,-24,20,17,14,brickmat,true);building(-28,25,16,18,12,brickmat,true);
// plaza, paths, benches, decorations
box(0,-.08,0,28,.3,28,pavemat);tree(0,0,12);for(let i=0;i<40;i++){let a=i/40*Math.PI*2;tree(Math.cos(a)*19,Math.sin(a)*19,3.5+Math.random()*2,false);}
for(let x=-34;x<=34;x+=7){lamp(x,-25);lamp(x,25)}for(let z=-34;z<=34;z+=7){lamp(-25,z);lamp(25,z)}
for(let i=0;i<12;i++){let x=-22+Math.random()*44,z=-22+Math.random()*44;if(Math.hypot(x,z)>10)tree(x,z,3+Math.random()*3)}
// festive cable lines
for(let i=0;i<17;i++){let x=-32+i*4;bulb(x,8,-23,[0xffd78a,0xffffff,0xa6dfff][i%3]);bulb(x,8,23,[0xffd78a,0xffffff,0xa6dfff][i%3]);}
// home nook, enclosed interior
box(-42,-.05,-42,20,.2,20,woodmat);box(-42,3,-52,20,6,.5,brickmat);box(-52,3,-42,.5,6,20,brickmat);box(-32,3,-42,.5,6,20,brickmat);box(-42,3,-32,20,6,.5,brickmat);box(-42,3.5,-50,5,2,.15,glass);box(-42,2,-45,4,1,3,darkmat);box(-45,1.2,-42,2.2,2.4,1,woodmat);box(-39,1,-36,3,2,1,woodmat);tree(-47,-47,3.4);box(-42,1,-36,2,2,1,darkmat);bulb(-49,5,-49,0xffc982);
addI(0,1.6,0,'Главная ёлка','Осмотреть городскую ёлку',()=>{if(quest>=2)advance();else toast('Сначала доберись до площади по заданию.');});
addI(18,1.5,4,'Супермаркет','Продукты — 500 ₽',()=>buy('Продукты',500,1));addI(-18,1.5,-5,'Магазин подарков','Подарок — 700 ₽',()=>buy('Подарок',700,5));addI(4,1.5,22,'Магазин декора','Гирлянда — 450 ₽',()=>buy('Гирлянда',450,10));addI(-42,1.5,-42,'Квартира','Отдохнуть и завершить домашние дела',()=>{if(quest>=4&&items.includes('Ёлка'))advance();else if(quest>=10)advance();else toast('Дом — твоя точка отдыха. Сохраняемся автоматически.');save();});addI(-27,1.5,20,'Ёлочный базар','Ёлка — 1200 ₽',()=>buy('Ёлка',1200,3));addI(22,1.5,-20,'Почта','Отправить открытку',()=>advanceTo(6));addI(-22,1.5,18,'Кафе','Горячий напиток — 150 ₽',()=>buy('Какао',150,7));addI(10,1.5,-28,'Сосед','Поздравить соседа',()=>advanceTo(8));addI(-8,1.5,8,'Снежный двор','Погулять по тихому двору',()=>{if(quest>=9)advance();else toast('Вдыхай морозный воздух и продолжай маршрут.');});}
function addI(x,y,z,name,desc,fn){let o=new THREE.Object3D();o.position.set(x,y,z);scene.add(o);interactables.push({o,name,desc,fn});}
function buy(name,cost,target){if(items.includes(name)){toast('Уже есть: '+name);return}if(money<cost){toast('Не хватает денег!');return}money-=cost;items.push(name);renderItems();toast('Куплено: '+name);save();if(quest<=target)advanceTo(target);}
function advanceTo(n){if(n>quest){quest=n;updateQuest();save();toast('Задание обновлено!');}}function advance(){quest=Math.min(quest+1,tasks.length-1);updateQuest();save();toast('Задание выполнено!');}
function snowflakes(){let n=6500,g=new THREE.BufferGeometry(),a=new Float32Array(n*3);for(let i=0;i<n;i++){a[i*3]=(Math.random()-.5)*220;a[i*3+1]=Math.random()*65;a[i*3+2]=(Math.random()-.5)*220;}g.setAttribute('position',new THREE.BufferAttribute(a,3));snow=new THREE.Points(g,new THREE.PointsMaterial({color:0xffffff,size:.105,transparent:true,opacity:.9}));scene.add(snow);}
function events(){window.addEventListener('resize',resize);document.addEventListener('keydown',e=>{keys[e.code]=true;if(e.code==='KeyE')interact();if(e.code==='Escape'&&started)pause();if(e.code==='KeyF')save();});document.addEventListener('keyup',e=>keys[e.code]=false);renderer.domElement.addEventListener('click',()=>{if(started&&!paused&&innerWidth>700)renderer.domElement.requestPointerLock?.();});document.addEventListener('mousemove',e=>{if(document.pointerLockElement===renderer.domElement){yaw-=e.movementX*.002;pitch=clamp(pitch-e.movementY*.002,-1.25,1.25);}});$('start').onclick=()=>newGame();$('load').onclick=()=>loadGame();$('how').onclick=()=>toast('WASD — движение, мышь — обзор, E — взаимодействие, Shift — бег, F — сохранение. На телефоне — кнопки движения и свайп в круге справа.');$('ebtn').onclick=interact;document.querySelectorAll('[data-m]').forEach(b=>{b.addEventListener('touchstart',e=>{e.preventDefault();keys['m'+b.dataset.m]=true;},{passive:false});b.addEventListener('touchend',()=>keys['m'+b.dataset.m]=false);b.addEventListener('touchcancel',()=>keys['m'+b.dataset.m]=false);});let look=$('look');look.addEventListener('touchmove',e=>{let t=e.touches[0];if(look._last){yaw-=(t.clientX-look._last.x)*.006;pitch=clamp(pitch-(t.clientY-look._last.y)*.006,-1.25,1.25)}look._last={x:t.clientX,y:t.clientY}},{passive:true});look.addEventListener('touchend',()=>look._last=null);}
function resize(){if(!renderer)return;camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);}
function newGame(){money=3500;items=[];quest=0;camera.position.set(-42,1.72,-42);yaw=0;pitch=0;start();updateQuest();save();}
function start(){started=true;paused=false;$('menu').style.display='none';$('mobile').style.display=innerWidth<900?'block':'none';$('look').style.display=innerWidth<900?'block':'none';}
function pause(){paused=!paused;$('menu').style.display=paused?'flex':'none';if(paused){$('panel').innerHTML='<h1>Пауза</h1><p>Прогресс сохранён.</p><button id="resume">Продолжить</button><button class="secondary" id="savebtn">Сохранить</button><button class="secondary" id="restart">Новая игра</button>'; $('resume').onclick=()=>{paused=false;$('menu').style.display='none';};$('savebtn').onclick=()=>{save();toast('Сохранено!');};$('restart').onclick=()=>newGame();}}
function save(){try{localStorage.setItem('winterGameSave',JSON.stringify({money,items,quest,camera:{x:camera.position.x,y:camera.position.y,z:camera.position.z},yaw,pitch,elapsed}));}catch(e){}}
function loadGame(){let s;try{s=JSON.parse(localStorage.getItem('winterGameSave')||'null')}catch(e){}if(!s){toast('Сохранение не найдено — начни новую игру.');return}money=s.money??3500;items=s.items||[];quest=s.quest||0;elapsed=s.elapsed||0;if(s.camera){camera.position.set(s.camera.x,s.camera.y,s.camera.z);yaw=s.yaw||0;pitch=s.pitch||0;}renderItems();updateQuest();start();}
function renderItems(){$('items').innerHTML=items.length?items.map(x=>'• '+x).join('<br>'):'Пока пусто';}
function updateQuest(){$('title').textContent='Задание: '+tasks[quest][0];$('sub').textContent=tasks[quest][1];$('stats').textContent='₽ '+money+' · '+items.length+' предметов · '+Math.floor(elapsed/60)+' мин в игре';renderItems();}
function toast(t){$('toast').textContent=t;$('toast').style.display='block';clearTimeout(toast.timer);toast.timer=setTimeout(()=> $('toast').style.display='none',2800);}
function interact(){if(near)near.fn();}
function animate(){requestAnimationFrame(animate);let dt=Math.min(clock.getDelta(),.05);if(started&&!paused){elapsed+=dt;saveTick+=dt;let f=0,s=0;if(keys.KeyW||keys.mf)f++;if(keys.KeyS||keys.mb)f--;if(keys.KeyA||keys.ml)s++;if(keys.KeyD||keys.mr)s--;let speed=(keys.ShiftLeft||keys.ShiftRight?6.4:3.7)*dt;camera.position.x+=Math.sin(yaw)*f*speed+Math.cos(yaw)*s*speed;camera.position.z+=-Math.cos(yaw)*f*speed+Math.sin(yaw)*s*speed;camera.position.y=1.72;camera.rotation.order='YXZ';camera.rotation.set(pitch,yaw,0);near=null;let best=3.2;for(let it of interactables){let d=camera.position.distanceTo(it.o.position);if(d<best){best=d;near=it;}}if(near){$('hint').style.display='block';$('hint').textContent='E · '+near.name+' — '+near.desc;$('interact').style.display='block';}else{$('hint').style.display='none';$('interact').style.display='none';}if(saveTick>12){save();saveTick=0;updateQuest();}}let a=snow.geometry.attributes.position.array;for(let i=0;i<a.length;i+=3){a[i]+=.012*Math.sin(a[i+2]*.04);a[i+1]-=.06;if(a[i+1]<0){a[i+1]=65;a[i]=(Math.random()-.5)*220;a[i+2]=(Math.random()-.5)*220;}}snow.geometry.attributes.position.needsUpdate=true;renderer.render(scene,camera);}
init();renderItems();updateQuest();if(localStorage.getItem('winterGameSave'))$('load').style.opacity=1;})();
</script></body></html>